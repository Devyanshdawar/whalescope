# ==============================================================================
# CRYPTO WHALE WATCHER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` in the project root and populate your production keys.
# Leave blank to use the high-performance local simulation & testing engine.

# --- COMMERCIALIZATION & MARKETPLACE BUYER DEMO SWITCH ---
# Set to 'true' to unlock all premium alpha rows & webhook features for buyer evaluation
VITE_DEMO_MODE=false
# Stripe Publishable Key Placeholder: pk_live_... or pk_test_...
VITE_STRIPE_PUBLIC_KEY=pk_test_51MzWhaleWatcherMockStripeKey9900AlphaDevProdAsset0000
# Monthly subscription tier price in USD
VITE_PREMIUM_MONTHLY_PRICE=79

# --- INDEXER PROVIDER SELECTION ---
# Options: "simulation" | "moralis" | "alchemy" | "debank"
VITE_INDEXER_PROVIDER=simulation
VITE_DEFAULT_CHAIN_ID=1

# --- MORALIS STREAMS & WEB3 API ---
# Signup: https://admin.moralis.io
VITE_MORALIS_API_KEY=
VITE_MORALIS_STREAM_SECRET=

# --- ALCHEMY WEB3 & WEBSOCKETS ---
# Signup: https://dashboard.alchemy.com
VITE_ALCHEMY_API_KEY=
VITE_ALCHEMY_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/your_alchemy_key_here

# --- DEBANK CLOUD OPEN API ---
# Docs: https://docs.open.debank.com
VITE_DEBANK_API_KEY=

# --- POLLING & PERFORMANCE TUNING ---
# Real-time transaction polling fallback interval in milliseconds
VITE_POLL_INTERVAL_MS=30000
# Smart wallet ledger refresh rate in milliseconds
VITE_LEDGER_REFRESH_MS=60000
# Maximum retry attempts on network error or rate limit
VITE_MAX_RETRIES=4
# Base exponential backoff in milliseconds
VITE_BACKOFF_BASE_MS=1500
# Memory cache TTL in milliseconds
VITE_CACHE_TTL_MS=45000

# --- AUTOMATED ALERTS & WEBHOOKS ---
# Minimum transaction USD value required to fire external webhook alerts
VITE_MIN_ALERT_THRESHOLD_USD=500000
# Discord Webhook integration
VITE_DISCORD_WEBHOOK_URL=
# Telegram Bot integration
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
# Client-side notifications
VITE_ENABLE_BROWSER_NOTIFICATIONS=true
VITE_ENABLE_SOUND_ALERTS=true
